#!/bin/sh
# K&A: 이 사본은 codex/llm-prototype 브랜치로만 push한다. main 등 다른 브랜치로 가는 push는 차단한다.
allowed="refs/heads/codex/llm-prototype"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" != "$allowed" ]; then
    echo "push 차단: '$remote_ref'(으)로 push할 수 없습니다. 이 사본은 codex/llm-prototype 브랜치로만 push합니다." >&2
    exit 1
  fi
done

exit 0
