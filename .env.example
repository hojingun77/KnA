# codex/llm-prototype 로컬 Node API 설정 (server/index.js가 읽음)
# 이 파일을 .env로 복사해서 값을 채운다. .env는 Git에 올리지 않는다.
# VITE_ 접두사를 붙이지 않는다. 브라우저에 공개되면 안 되는 값이다.

# Google Cloud Translation Basic(v2) API 키. 비워 두면 번역은 로컬 sLLM만 사용한다.
GOOGLE_TRANSLATE_API_KEY=

# 로컬 sLLM (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# 질문 보상 분류만 더 빠른 모델로 돌릴 때 (예: qwen2.5:3b). 비우면 OLLAMA_MODEL 사용
OLLAMA_REWARD_MODEL=

# Node API 포트 (vite.config.js 프록시와 같아야 함)
PORT=8787

# 이전 단계 자리값. 이 브랜치에서는 사용하지 않는다.
OPENAI_API_KEY=
