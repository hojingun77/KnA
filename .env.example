# Firebase 설정 (Firebase 콘솔 > 프로젝트 설정 > 웹 앱에서 복사)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Emulator 사용 여부 (로컬 개발: true, 프로덕션: false)
VITE_USE_EMULATOR=true

# Algolia 검색 (Algolia 대시보드 > API Keys)
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=   # Search-only API key (공개 가능)

# OpenAI (Cloud Functions에서만 사용 — 프론트에 노출 금지)
# functions/.env 에 별도 관리
# OPENAI_API_KEY=
